# Copia questo file in ".env.local" per lo sviluppo in locale.
# Su Vercel queste variabili si impostano in: Settings -> Environment Variables.

# Stringa di connessione Postgres. Su Vercel la imposta in automatico
# l'integrazione Neon (Storage -> Create Database -> Neon).
DATABASE_URL=postgresql://utente:password@ep-xxxx-pooler.eu-central-1.aws.neon.tech/neondb?sslmode=require

# PIN dell'area operatore (/checkin), almeno 6 caratteri.
STAFF_PIN=scegli-un-pin
